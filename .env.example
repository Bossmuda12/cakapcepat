# --- Server ---
PORT=3000
NODE_ENV=development
JWT_SECRET=ganti-dengan-random-string-yang-panjang

# --- PostgreSQL ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cakapcepat

# --- Redis (dipakai BullMQ untuk antrean broadcast) ---
REDIS_URL=redis://localhost:6379

# --- WhatsApp Cloud API ---
# Didapat setelah Business Verification langsung ke Meta (lihat Bab 7 dokumen rencana).
# TIDAK perlu Tech Provider Program karena ini pemakaian internal.
WHATSAPP_PHONE_NUMBER_ID=isi-dari-meta-business-manager
WHATSAPP_BUSINESS_ACCOUNT_ID=isi-dari-meta-business-manager
WHATSAPP_ACCESS_TOKEN=isi-token-akses-permanen-system-user
WHATSAPP_APP_SECRET=isi-dari-meta-app-settings
WHATSAPP_WEBHOOK_VERIFY_TOKEN=buat-string-rahasia-sendiri-untuk-verifikasi-webhook

# --- Meta Conversions API (CAPI) — untuk pelacakan iklan CTWA (Bab 8 dokumen rencana) ---
META_PIXEL_ID=isi-pixel-id-yang-dipakai-campaign-ctwa
META_CAPI_ACCESS_TOKEN=isi-access-token-conversions-api

# --- AI Chatbot (opsional di Fase 1 awal, isi kalau sudah siap) ---
AI_PROVIDER_API_KEY=

# --- Broadcast rate limiting (pesan per menit, untuk hindari nomor diblokir) ---
BROADCAST_RATE_PER_MINUTE=60
