{
  "name": "cakapcepat",
  "version": "0.2.0",
  "private": true,
  "description": "Kerangka MVP internal — otomasi WhatsApp untuk tim sendiri (bukan produk dijual).",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.json && cp src/db/schema.sql dist/db/schema.sql && vite build",
    "start": "node dist/db/migrate.js && node dist/server.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "worker": "tsx watch src/queue/broadcastWorker.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.12.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.10",
    "@types/pg": "^8.11.6",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^4.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vite": "^5.4.0"
  }
}
